<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.studentrecordsystem.Controller">

    <padding>
        <Insets bottom="15.0" left="14.0" right="15.0" top="15.0" />
    </padding>

    <!-- INPUTS -->
    <TextField fx:id="txtName" promptText="Name" />
    <TextField fx:id="txtCourse" promptText="Course" />
   <ChoiceBox fx:id="cbYear" prefWidth="150.0" />

    <!-- BUTTONS -->
    <HBox spacing="10.0">
        <Button fx:id="btnAdd" onAction="#addStudent" prefHeight="25.0" prefWidth="80.0" text="Add">
         <HBox.margin>
            <Insets left="100.0" />
         </HBox.margin></Button>
        <Button fx:id="btnUpdate" onAction="#updateStudent" prefHeight="25.0" prefWidth="80.0" text="Update" />
        <Button fx:id="btnDelete" onAction="#deleteStudent" prefHeight="25.0" prefWidth="80.0" text="Delete" />
        <Button fx:id="btnClear" onAction="#clearFields" prefHeight="25.0" prefWidth="80.0" text="Clear" />
    </HBox>

    <!-- TABLE -->
    <TableView fx:id="table" prefHeight="311.0" prefWidth="600.0">

        <columns>
            <TableColumn fx:id="colId" prefWidth="150.0" text="ID" />
            <TableColumn fx:id="colName" prefWidth="150" text="NAME" />
            <TableColumn fx:id="colCourse" prefWidth="150" text="COURSE" />
            <TableColumn fx:id="colYear" prefWidth="150" text="YEAR " />
        </columns>

    </TableView>

</VBox>
